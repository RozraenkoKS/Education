def main(a, b, n, m):
    n_min = a * (n - 1) + n
    n_max = a * (n + 1) + n 
    m_min = b * (m - 1) + m
    m_max = b * (m + 1) + m
    x = max(n_min, m_min)
    y = min(n_max, m_max)
    
    if x <= y:
        return f'{x} {y}'
    else:
        return '-1'
    
if __name__ == '__main__':
    a, b, n, m = int(input()), int(input()), int(input()), int(input())
    print(main(a, b, n, m))

    
